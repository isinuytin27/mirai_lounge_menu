{
    "name": "mirai-lounge/site",
    "description": "Mirai Lounge public site and admin",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.14",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6",
        "minishlink/web-push": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mirai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mirai\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
