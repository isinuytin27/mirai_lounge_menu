# Конфиг быстрого деплоя. Скопируй в scripts/deploy.env (он в .gitignore) и заполни.
# scripts/deploy.env НЕ коммитится — это твои доступы к серверу.

# Куда деплоим (пользователь@хост). Пользователь deploy, публичный адрес роутера.
SSH_TARGET=deploy@87.251.104.230

# Внешний SSH-порт (из SERVER_SETUP.md: проброс 49222 → 2222 на сервере).
# Из локальной сети можно 2222 и внутренний адрес.
SSH_PORT=49222

# Каталог проекта на сервере (DEPLOY_PATH).
REMOTE_PATH=/var/www/mirailounge

# (необязательно) URL для авто-проверки живости в конце деплоя.
HEALTH_URL=https://mirailounge.ru/_health
