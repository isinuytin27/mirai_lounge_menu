# Скопируйте в файл .env в корне проекта (рядом с composer.json).
# Docker Compose передаёт переменные в контейнер PHP (см. docker-compose.yml).
#
# Telegram: по умолчанию задан в config/config.php. Здесь — только если нужно переопределить.
MIRAI_TG_BOT_TOKEN=
MIRAI_TG_CHAT_ID=
# Если до api.telegram.org нет прямого доступа (таймаут): http://user:pass@host:port или http://127.0.0.1:7890
MIRAI_TG_HTTP_PROXY=

# Web Push (сгенерировать: php scripts/generate-vapid.php)
MIRAI_VAPID_PUBLIC=
MIRAI_VAPID_PRIVATE=
MIRAI_VAPID_SUBJECT=mailto:admin@mirailounge.ru
