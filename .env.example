# Скопируйте в файл .env в корне проекта (рядом с composer.json).
# Docker Compose передаёт переменные в контейнеры PHP и Postgres (см. docker-compose.yml).

# --- База данных (Postgres) ---
# Эти же имена читают и контейнер postgres, и PHP-приложение (Config::db()).
# Если оставить пустыми — обе стороны используют одинаковые dev-дефолты (mirailounge / mirailounge / mirailounge_dev),
# так что локально всё поднимется без правок. В ПРОДЕ обязательно задайте сильный POSTGRES_PASSWORD.
POSTGRES_DB=mirailounge
POSTGRES_USER=mirailounge
POSTGRES_PASSWORD=mirailounge_dev
# Хост/порт — внутри docker-сети имя сервиса "postgres"; для запуска с хоста укажите 127.0.0.1 и проброшенный порт.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Окружение приложения: dev | prod. В prod ошибки не показываются в HTTP-ответе.
APP_ENV=dev


# Подпись cookie стола (QR-сессия). ОБЯЗАТЕЛЬНО смените на длинную случайную строку.
# Сгенерировать: php -r 'echo bin2hex(random_bytes(32));'
MIRAI_TABLE_SIGNING_KEY=

# Telegram: токен бота и chat_id. Пустые — отправка отключается.
MIRAI_TG_BOT_TOKEN=
MIRAI_TG_CHAT_ID=
# Если с сервера НЕТ доступа к api.telegram.org (блокировка) — один из двух способов:
#  A) HTTP/SOCKS-прокси до Telegram: http://user:pass@host:port  или  socks5h://host:port
MIRAI_TG_HTTP_PROXY=
#  B) реверс-прокси Bot API (например Cloudflare Worker). Пусто = https://api.telegram.org
MIRAI_TG_API_BASE=

# Web Push (сгенерировать: php scripts/generate-vapid.php)
MIRAI_VAPID_PUBLIC=
MIRAI_VAPID_PRIVATE=
MIRAI_VAPID_SUBJECT=mailto:admin@mirailounge.ru
