.DS_Store

# Локальные секреты для Docker / Telegram / VAPID
.env

# Локальное состояние Claude Code
.claude/

# Runtime data (do not commit)
/data/menu.json
/data/gallery.json
/data/orders.json
/data/push_subscriptions.json
/data/vip_events.json
/data/vip_guests.json
/data/admin_users.json
/data/tickets.json
/data/tournaments.json

/vendor/
composer.phar

# Uploaded images (do not commit)
/public/assets/img/menu/uploads/*
!/public/assets/img/menu/uploads/.gitkeep
/public/assets/img/gallery/uploads/*
!/public/assets/img/gallery/uploads/.gitkeep
/public/assets/img/vip/partner_uploads/*
!/public/assets/img/vip/partner_uploads/.gitkeep

# Node / build leftovers (future-proof)
node_modules/
dist/
build/

# Рантайм нового стека
/var/
.phpunit.cache/
.phpunit.result.cache

# graphify — сгенерированный граф проекта (артефакт, не исходник)
/graphify-out/

# Локальный docker override (dev-запуск нового стека)
docker/docker-compose.override.yml
/miraipro_site/


# SSL сертификаты и приватные ключи (СЕКРЕТЫ — никогда не коммитить)
# Любые ключи/сертификаты по расширению, где бы ни лежали:
*.key
*.pem
*.crt
*.p12
*.pfx
# Производные каталоги сертов по доменам:
docker/ssl/*/
# Разрешаем служебные файлы каталога ssl:
!docker/ssl/.gitkeep
!docker/ssl/README.md
!docker/ssl/setup-certs.sh
!docker/ssl/setup-certs.bat

# Postgres data volume (runtime)
/data/pg/

# Mirai Pro — отдельный проект (../mirai_pro). install-into-stack.bat кладёт сюда
# код сайта, vhost и cert — в git lounge их не держим.
/miraipro_site/
docker/nginx/conf.d/miraipro.conf


# Скриншоты отладки
/*.png

# Локальный vendor для документации (mermaid ~2.5MB, качается заново)
/assets-doc/

# локальные доступы к серверу для scripts/deploy.sh
scripts/deploy.env
