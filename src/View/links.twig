<script>
(function(){
  document.querySelectorAll('.links-card, .links-branch').forEach(function(el){
    el.classList.add('links-glass');
    var f = document.createElement('div'); f.className = 'links-glass-filter';
    f.setAttribute('aria-hidden', 'true');
    var o = document.createElement('div'); o.className = 'links-glass-overlay';
    o.setAttribute('aria-hidden', 'true');
    var s = document.createElement('div'); s.className = 'links-glass-specular';
    s.setAttribute('aria-hidden', 'true');
    el.insertBefore(s, el.firstChild);
    el.insertBefore(o, el.firstChild);
    el.insertBefore(f, el.firstChild);
  });
})();

document.querySelectorAll(".links-item-copy").forEach(function(btn){
  btn.addEventListener("click", function(ev){
    ev.preventDefault();
    ev.stopPropagation();
    if (btn.disabled) return;
    var t = btn.getAttribute("data-copy") || "";
    if (!t) return;
    function ok(){
      var prev = btn.getAttribute("title") || "";
      btn.setAttribute("title", "Скопировано");
      btn.classList.add("links-item-copy--done");
      setTimeout(function(){
        btn.setAttribute("title", prev || "Скопировать в буфер");
        btn.classList.remove("links-item-copy--done");
      }, 1600);
    }
    function fallback(){
      var ta = document.createElement("textarea");
      ta.value = t;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); ok(); } catch (e) {}
      document.body.removeChild(ta);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t).then(ok).catch(fallback);
    } else {
      fallback();
    }
  });
});
</script>
