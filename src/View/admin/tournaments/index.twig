{% extends 'admin/layout.twig' %}
{% block title %}Турниры{% endblock %}

{% block head %}
<style>
  .cnt{display:flex;gap:14px;margin:0 0 16px}
  .cnt div{font-size:12px;color:var(--dim)} .cnt b{color:var(--ink);font-size:18px;display:block}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media(max-width:600px){.grid2{grid-template-columns:1fr}}
  .check{display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer}
  .check input{width:18px;height:18px;accent-color:var(--accent)}
  .app{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:12px 14px;margin-bottom:8px}
  .app.rejected{opacity:.55}
  .app .h{display:flex;align-items:center;gap:10px}
  .app .team{font-weight:700;font-size:15px}
  .app .meta{color:var(--dim);font-size:12px;margin-top:4px;line-height:1.5}
  .app .players{margin-top:6px;font-size:12.5px}
  .app .players span{background:#170f1e;border:1px solid var(--line);border-radius:8px;padding:2px 8px;margin-right:5px;display:inline-block;margin-top:4px}
  .mini{background:#170f1e;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:5px 8px;font-size:12px}
  .del{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:5px 9px;cursor:pointer;font-size:12px}
  .del:hover{border-color:var(--accent);color:#ffb3d6}
  .flash{background:rgba(57,217,138,.12);border:1px solid var(--line);color:var(--ok);padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:12px}
  a.tglink{color:var(--accent2);font-size:12px}
  form.inline{display:inline}
</style>
{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
    <a href="/admin" style="color:var(--dim)">← Обзор</a>
    <h1 style="margin:0;font-size:22px">Турниры</h1>
    <span style="margin-left:auto;font-size:10px;font-weight:700;color:var(--ok);background:rgba(57,217,138,.14);padding:2px 8px;border-radius:20px">Postgres</span>
</div>
{% if flash %}<div class="flash">✓ {{ flash }}</div>{% endif %}

<div class="cnt">
    <div><b>{{ counts.total }}</b> заявок</div>
    <div><b>{{ counts.new }}</b> новых</div>
    <div><b>{{ counts.accepted }}</b> принято</div>
    <div><b>{{ slots_left }}</b> мест свободно</div>
</div>

<form class="card" method="post" action="/admin/tournaments/settings" style="margin-bottom:22px">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <h3 style="margin:0 0 12px;font-size:15px">Настройки турнира</h3>
    <div class="grid2">
        <div class="field"><label>Формат</label><input class="input" name="format" value="{{ settings.format }}"></div>
        <div class="field"><label>Мест (max_slots)</label><input class="input" type="number" name="max_slots" value="{{ settings.max_slots }}"></div>
        <div class="field"><label>Состав</label><input class="input" name="roster" value="{{ settings.roster }}"></div>
        <div class="field"><label>Дедлайн</label><input class="input" name="deadline" value="{{ settings.deadline }}"></div>
        <div class="field"><label>Взнос</label><input class="input" name="fee" value="{{ settings.fee }}"></div>
    </div>
    <label class="check" style="margin:6px 0 16px"><input type="checkbox" name="registration_open" {{ settings.registration_open ? 'checked' }}> Регистрация открыта</label>
    <div><button class="btn" type="submit">Сохранить настройки</button></div>
</form>

<h3 style="font-size:15px;margin:0 0 10px">Заявки</h3>
{% for a in applications %}
    <div class="app {{ a.status }}">
        <div class="h">
            <span class="team">{{ a.team_name }}</span>
            <form class="inline" method="post" action="/admin/tournaments/app/{{ a.id }}/status" style="margin-left:auto">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <select class="mini" name="status" onchange="this.form.submit()">
                    {% for k,l in statuses %}<option value="{{ k }}" {{ k==a.status?'selected' }}>{{ l }}</option>{% endfor %}
                </select>
            </form>
            <form class="inline" method="post" action="/admin/tournaments/app/{{ a.id }}/delete" onsubmit="return confirm('Удалить заявку?')">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="del">✕</button>
            </form>
        </div>
        <div class="meta">
            Рейтинг: {{ a.rating }}{% if a.experience %} · Опыт: {{ a.experience }}{% endif %}<br>
            Капитан: {{ a.captain_name }} · <a class="tglink" href="{{ a.captain_steam }}">Steam</a> · TG {{ a.captain_telegram }} · {{ a.captain_phone }}
        </div>
        {% if a.players %}<div class="players">Игроки: {% for p in a.players %}<span>{{ p.nick }}</span>{% endfor %}</div>{% endif %}
    </div>
{% else %}
    <p style="color:var(--dim)">Заявок пока нет.</p>
{% endfor %}
{% endblock %}
