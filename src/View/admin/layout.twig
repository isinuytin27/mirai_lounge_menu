<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Админка{% endblock %} · {{ site.name }}</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#0a0910">
    <style>
        :root{color-scheme:dark;
          --bg:#0a0910;--panel:rgba(20,16,28,.72);--line:rgba(245,0,125,.18);
          --ink:#f4eef7;--dim:#9b8fae;--accent:#f5007d;--accent2:#7b5cff;--ok:#39d98a;--warn:#ffab3d;}
        *{box-sizing:border-box}
        body{margin:0;min-height:100vh;background:
          radial-gradient(900px 500px at 80% -120px,#1a0f1e,#0a0910 60%);
          color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
        a{color:var(--accent2);text-decoration:none}
        /* Ярлычок ассета (расширение+размер) поверх картинки */
        .asset-thumb{position:relative;display:block}
        .asset-badge{position:absolute;left:6px;top:6px;z-index:2;display:inline-block;
          font:700 10px/1 ui-monospace,monospace;letter-spacing:.03em;padding:4px 7px;border-radius:6px;
          background:rgba(10,9,16,.82);color:var(--ok);border:1px solid rgba(57,217,138,.4);
          text-transform:uppercase;pointer-events:none;backdrop-filter:blur(2px)}
        .asset-badge.bad{color:#ffd0e2;background:rgba(245,0,125,.85);border-color:var(--accent)}
        .admin-top{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--line);
          background:rgba(10,8,16,.6);backdrop-filter:blur(12px);position:sticky;top:0;z-index:10}
        .admin-top .brand{font-weight:800;letter-spacing:.1em;font-size:13px}
        .admin-top .brand b{color:var(--accent)}
        .admin-top .who{margin-left:auto;color:var(--dim);font-size:13px}
        .admin-top .who b{color:var(--ink)}
        .admin-top .role{font-size:11px;color:var(--accent);border:1px solid var(--line);padding:2px 8px;border-radius:20px;margin-left:8px}
        .admin-top a.logout{color:var(--dim);font-size:13px;margin-left:14px}
        .admin-wrap{max-width:960px;margin:0 auto;padding:26px 20px 60px}
        .card{background:var(--panel);border:1px solid var(--line);border-radius:16px;
          backdrop-filter:blur(14px);padding:18px 20px}
        .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
          background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border:none;
          padding:11px 18px;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer}
        .input{width:100%;background:#170f1e;border:1px solid var(--line);color:var(--ink);
          padding:12px 14px;border-radius:12px;font-size:15px;outline:none}
        .input:focus{border-color:var(--accent)}
        label{display:block;font-size:12.5px;color:var(--dim);margin:0 0 6px}
        .field{margin-bottom:14px}
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    {% block chrome %}
    <div class="admin-top">
        <div class="brand">◆ <b>MIRAI</b> ADMIN</div>
        {% if user is defined and user %}
            <div class="who"><b>{{ user.displayName }}</b><span class="role">{{ user.role.label }}</span></div>
            <a class="logout" href="/admin/logout">Выйти</a>
        {% endif %}
    </div>
    {% endblock %}

    <div class="admin-wrap">
        {% block content %}{% endblock %}
    </div>
</body>
</html>
