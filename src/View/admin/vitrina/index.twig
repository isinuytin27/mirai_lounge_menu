{% extends 'admin/layout.twig' %}
{% import 'admin/_macros.twig' as a %}
{% block title %}Витрина кальянов{% endblock %}

{% block head %}
<style>
  .vg{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:12px 14px;margin-bottom:10px}
  .vg .rowline{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
  .vg .fld{display:flex;flex-direction:column;gap:4px}
  .vg label{font-size:11px;color:var(--dim)}
  .vg input.input,.vg .input{background:#170f1e;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:7px 9px;font-size:13px}
  .vg .thumb{width:54px;height:54px;border-radius:8px;object-fit:cover;border:1px solid var(--line);background:#0d0d10}
  .vg .btn.mini{padding:7px 12px;font-size:12px}
  .del{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:7px 10px;cursor:pointer;font-size:12px}
  .del:hover{border-color:var(--accent);color:#ffb3d6}
  .check{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--dim)}
  h3{font-size:15px;margin:26px 0 10px}
  .muted{color:var(--dim);font-size:12px}
  form.inline{display:inline}
  .w70{width:70px} .w90{width:90px} .w120{width:120px} .grow{flex:1;min-width:150px}
</style>
{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
    <a href="/admin" style="color:var(--dim)">← Обзор</a>
    <h1 style="margin:0;font-size:22px">Витрина кальянов</h1>
    <a href="/vitrina" target="_blank" class="pill" style="margin-left:auto;text-decoration:none;color:var(--accent2)">↗ Открыть витрину</a>
</div>
{% if flash %}<p class="muted">✓ {{ flash }}</p>{% endif %}
<p class="muted">Цена/название/описание кальяна — в <a href="/admin/menu" style="color:var(--accent2)">меню</a> (это товары). Здесь — картинки, геометрия, чаши и напитки.</p>

<h3>Кальяны (витрина)</h3>
{% for h in hookahs %}
<form class="vg" method="post" action="/admin/vitrina/hookah/{{ h.id }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="rowline">
        <div class="asset-thumb">{% if h.image %}{{ a.img_badge(h.image) }}{% endif %}<img class="thumb" src="{{ h.image }}" alt="" onerror="this.style.opacity=.2"></div>
        <div class="fld grow"><label>{{ h.name }} · {{ h.price }} ₽ — картинка (путь)</label>
            <div style="display:flex;gap:6px"><input class="input grow img-path" name="image" value="{{ h.image }}"><input type="file" accept="image/*" class="img-up" style="max-width:120px;font-size:11px"></div></div>
        <div class="fld"><label>Модель</label><input class="input w120" name="model" value="{{ h.model ?? '' }}"></div>
        <div class="fld"><label>img_w</label><input class="input w70" name="img_w" type="number" value="{{ h.img_w }}"></div>
        <div class="fld"><label>img_h</label><input class="input w70" name="img_h" type="number" value="{{ h.img_h }}"></div>
        <div class="fld grow"><label>anchors (JSON шахт)</label><input class="input grow" name="anchors" value="{{ h.anchors }}"></div>
        <label class="check"><input type="checkbox" name="active" {{ h.active ? 'checked' }}> вкл</label>
        <button class="btn mini" type="submit">Сохранить</button>
    </div>
</form>
{% endfor %}

<h3>Чаши <span class="muted">— наценка × число шахт</span></h3>
{% for b in bowls %}
<form class="vg" method="post" action="/admin/vitrina/bowl/{{ b.id }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="rowline">
        <div class="asset-thumb">{% if b.image %}{{ a.img_badge(b.image) }}{% endif %}<img class="thumb" src="{{ b.image }}" alt="" onerror="this.style.opacity=.2"></div>
        <div class="fld"><label>Название</label><input class="input w120" name="name" value="{{ b.name }}"></div>
        <div class="fld grow"><label>Картинка</label><div style="display:flex;gap:6px"><input class="input grow img-path" name="image" value="{{ b.image }}"><input type="file" accept="image/*" class="img-up" style="max-width:120px;font-size:11px"></div></div>
        <div class="fld"><label>img_w</label><input class="input w70" name="img_w" type="number" value="{{ b.img_w }}"></div>
        <div class="fld"><label>img_h</label><input class="input w70" name="img_h" type="number" value="{{ b.img_h }}"></div>
        <div class="fld"><label>f (масштаб)</label><input class="input w70" name="f" value="{{ b.f }}"></div>
        <div class="fld"><label>Наценка ₽</label><input class="input w90" name="extra" type="number" value="{{ b.extra }}"></div>
        <div class="fld"><label>kind</label><input class="input w120" name="kind" value="{{ b.kind ?? '' }}"></div>
        <label class="check"><input type="checkbox" name="active" {{ b.active ? 'checked' }}> вкл</label>
        <button class="btn mini" type="submit">✓</button>
    </div>
</form>
<form class="inline" method="post" action="/admin/vitrina/bowl/{{ b.id }}/delete" onsubmit="return confirm('Удалить чашу?')" style="margin:-6px 0 10px">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button class="del">Удалить чашу «{{ b.name }}»</button>
</form>
{% endfor %}
<details class="vg"><summary style="cursor:pointer;font-weight:700">+ Новая чаша</summary>
<form method="post" action="/admin/vitrina/bowl" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="rowline">
        <div class="fld"><label>Название</label><input class="input w120" name="name" required></div>
        <div class="fld grow"><label>Картинка</label><div style="display:flex;gap:6px"><input class="input grow img-path" name="image"><input type="file" accept="image/*" class="img-up" style="max-width:120px;font-size:11px"></div></div>
        <div class="fld"><label>img_w</label><input class="input w70" name="img_w" type="number" value="700"></div>
        <div class="fld"><label>img_h</label><input class="input w70" name="img_h" type="number" value="700"></div>
        <div class="fld"><label>f</label><input class="input w70" name="f" value="0.5"></div>
        <div class="fld"><label>Наценка ₽</label><input class="input w90" name="extra" type="number" value="0"></div>
        <div class="fld"><label>kind</label><input class="input w120" name="kind"></div>
        <button class="btn mini" type="submit">Добавить</button>
    </div>
</form></details>

<h3>Напитки <span class="muted">— витринный ряд</span></h3>
{% for d in drinks %}
<form class="vg" method="post" action="/admin/vitrina/drink/{{ d.id }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="rowline">
        <div class="asset-thumb">{% if d.image %}{{ a.img_badge(d.image) }}{% endif %}<img class="thumb" src="{{ d.image }}" alt="" onerror="this.style.opacity=.2"></div>
        <div class="fld"><label>Название</label><input class="input w120" name="name" value="{{ d.name }}"></div>
        <div class="fld grow"><label>Картинка</label><div style="display:flex;gap:6px"><input class="input grow img-path" name="image" value="{{ d.image }}"><input type="file" accept="image/*" class="img-up" style="max-width:120px;font-size:11px"></div></div>
        <label class="check"><input type="checkbox" name="active" {{ d.active ? 'checked' }}> вкл</label>
        <button class="btn mini" type="submit">✓</button>
    </div>
</form>
<form class="inline" method="post" action="/admin/vitrina/drink/{{ d.id }}/delete" style="margin:-6px 0 10px">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button class="del">Удалить</button>
</form>
{% endfor %}
<details class="vg"><summary style="cursor:pointer;font-weight:700">+ Новый напиток</summary>
<form method="post" action="/admin/vitrina/drink" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="rowline">
        <div class="fld"><label>Название</label><input class="input w120" name="name" required></div>
        <div class="fld grow"><label>Картинка</label><div style="display:flex;gap:6px"><input class="input grow img-path" name="image"><input type="file" accept="image/*" class="img-up" style="max-width:120px;font-size:11px"></div></div>
        <button class="btn mini" type="submit">Добавить</button>
    </div>
</form></details>

<script>
// Инлайн-загрузка: файл -> POST /admin/vitrina/image -> путь в соседнее поле + превью.
document.addEventListener('change', function (e) {
    var inp = e.target.closest ? e.target.closest('.img-up') : null;
    if (!inp || !inp.files || !inp.files[0]) return;
    var wrap = inp.closest('.rowline');
    var field = wrap && wrap.querySelector('.img-path');
    var thumb = wrap && wrap.querySelector('.thumb');
    var fd = new FormData();
    fd.append('image', inp.files[0]);
    fd.append('_csrf', '{{ csrf_token() }}');
    inp.disabled = true;
    fetch('/admin/vitrina/image', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (j) {
            inp.disabled = false;
            if (j && j.ok) { if (field) field.value = j.path; if (thumb) { thumb.src = j.path; thumb.style.opacity = 1; } }
            else alert('Ошибка загрузки: ' + ((j && j.error) || ''));
        })
        .catch(function () { inp.disabled = false; alert('Сеть недоступна'); });
});
</script>
{% endblock %}
