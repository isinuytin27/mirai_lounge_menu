{% extends 'admin/layout.twig' %}
{% block title %}{{ p.name }}{% endblock %}

{% block head %}
<style>
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media(max-width:600px){.grid2{grid-template-columns:1fr}}
  textarea.input{min-height:70px;resize:vertical;font-family:inherit}
  .row{display:flex;gap:10px;align-items:center}
  .check{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ink);cursor:pointer}
  .check input{width:18px;height:18px;accent-color:var(--accent)}
  .pair{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--line);
    border-radius:10px;background:var(--panel);margin-bottom:6px}
  .pair .w{font-size:11px;color:var(--accent2);font-variant-numeric:tabular-nums}
  .pair .k{font-size:10px;color:var(--dim);border:1px solid var(--line);padding:1px 7px;border-radius:10px}
  .del{margin-left:auto;background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:4px 9px;cursor:pointer;font-size:12px}
  .del:hover{border-color:var(--accent);color:#ffb3d6}
  h3{font-size:15px;margin:24px 0 10px;display:flex;align-items:center;gap:8px}
  .muted{color:var(--dim);font-size:12px}
  .imgcard{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
  .imgcard .asset-thumb{flex:0 0 auto}
  .imgcard img.prev{width:140px;height:105px;object-fit:cover;border-radius:10px;border:1px solid var(--line);background:#0d0d10;display:block}
  .imgcard .noimg{width:140px;height:105px;border-radius:10px;border:1px dashed var(--line);display:flex;align-items:center;justify-content:center;color:var(--dim);font-size:12px}
  .imgcard .acts{display:flex;flex-direction:column;gap:8px}
  .up-lbl{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border:1px solid var(--line);border-radius:9px;color:var(--ink);cursor:pointer;font-size:13px}
  .up-lbl:hover{border-color:var(--accent2)}
  .dl-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--line);border-radius:9px;color:var(--accent2);text-decoration:none;font-size:13px}
  .dl-btn:hover{border-color:var(--accent2);filter:brightness(1.1)}
  .up-msg{font-size:12px;color:var(--dim)}
</style>
{% endblock %}

{% block content %}
{% import 'admin/_macros.twig' as a %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
    <a href="/admin/menu" style="color:var(--dim)">← Меню</a>
    <h1 style="margin:0;font-size:21px">{{ p.name }}</h1>
    <code style="margin-left:auto;color:var(--dim);font-size:12px">{{ p.slug }}</code>
</div>

<div class="card" style="margin-bottom:12px">
    <h3 style="margin-top:0">Фото товара</h3>
    <div class="imgcard" data-img-block data-slug="{{ p.slug }}">
        {% if p.image %}
        <div class="asset-thumb"><img class="prev" data-img-prev src="/{{ p.image|trim('/') }}" alt="" onerror="this.style.opacity=.25">{{ a.img_badge(p.image) }}</div>
        {% else %}
        <div class="noimg" data-img-prev-empty>нет фото</div>
        {% endif %}
        <div class="acts">
            <label class="up-lbl">⬆ Загрузить / заменить
                <input type="file" accept="image/*" data-img-up hidden>
            </label>
            <a class="dl-btn" data-img-dl href="{% if p.image %}/{{ p.image|trim('/') }}{% else %}#{% endif %}" download {% if not p.image %}style="display:none"{% endif %}>⬇ Скачать ассет</a>
            <span class="up-msg" data-img-msg></span>
        </div>
    </div>
</div>

<form class="card" method="post" action="/admin/menu/product/{{ p.slug }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="field"><label>Название</label><input class="input" name="name" value="{{ p.name }}" required></div>
    <div class="grid2">
        <div class="field"><label>Цена, ₽</label><input class="input" name="price" type="number" value="{{ p.price }}" required></div>
        <div class="field"><label>Порция</label>
            <div class="row">
                <input class="input" name="portion_value" value="{{ p.portion_value ?? '' }}" placeholder="270" style="flex:2">
                <input class="input" name="portion_unit" value="{{ p.portion_unit ?? '' }}" placeholder="г/мл/шт" style="flex:1">
            </div>
        </div>
    </div>
    <div class="field"><label>Время приготовления (для кальяна)</label><input class="input" name="prep_time" value="{{ p.prep_time ?? '' }}" placeholder="40-60 минут"></div>
    <div class="field"><label>Короткое описание (для карточки)</label><input class="input" name="description_short" value="{{ p.description_short ?? '' }}"></div>
    <div class="field"><label>Полное описание</label><textarea class="input" name="description">{{ p.description ?? '' }}</textarea></div>
    <div class="field"><label>Состав</label><textarea class="input" name="composition">{{ p.composition ?? '' }}</textarea></div>
    <div class="field">
        <label>Теги рекомендатора <span class="muted">— переопределяют теги категории; пусто = наследуются</span></label>
        <input class="input" name="rec_tags" value="{{ rec_tags|join(' ') }}" placeholder="anchor smoky chill">
        <div class="muted" style="margin-top:6px">
            Доступные:
            {% for t in all_tags %}<code title="{{ t.ru }} ({{ t.group }})">{{ t.slug }}</code>{% if not loop.last %} · {% endif %}{% endfor %}
        </div>
    </div>
    <div class="row" style="gap:24px;margin:6px 0 16px">
        <label class="check"><input type="checkbox" name="visible" {{ p.visible ? 'checked' }}> Виден гостю</label>
        <label class="check"><input type="checkbox" name="available" {{ p.available ? 'checked' }}> В наличии</label>
    </div>
    <button class="btn" type="submit">Сохранить</button>
</form>

<h3>◆ Гастропары <span class="muted">— считаются автоматически (граф категорий/тегов)</span></h3>
{% for pr in recommendations %}
    <div class="pair">
        <span>{{ pr.name }} <span class="muted">· {{ pr.price }} ₽</span></span>
        <span class="w">score {{ pr.weight }}</span>
    </div>
{% else %}
    <p class="muted">Движок не нашёл сильных пар (score ниже порога). Проверьте категорию/теги товара.</p>
{% endfor %}
<p class="muted" style="margin-top:8px">Связки не заводятся руками: задайте товару правильные теги — рекомендации подстроятся.</p>

<script>
// Загрузка/замена фото товара: файл -> POST -> обновляем превью и ссылку скачивания.
(function () {
    var block = document.querySelector('[data-img-block]');
    if (!block) return;
    var input = block.querySelector('[data-img-up]');
    var msg = block.querySelector('[data-img-msg]');
    var slug = block.getAttribute('data-slug');
    input && input.addEventListener('change', function () {
        var f = input.files && input.files[0];
        if (!f) return;
        var fd = new FormData();
        fd.append('image', f);
        fd.append('_csrf', '{{ csrf_token() }}');
        msg.textContent = 'Загрузка…';
        fetch('/admin/menu/product/' + encodeURIComponent(slug) + '/image', { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                if (!j || !j.ok) { msg.textContent = 'Ошибка: ' + ((j && j.error) || 'не удалось'); return; }
                var v = '?v=' + Date.now();
                var prev = block.querySelector('[data-img-prev]');
                var empty = block.querySelector('[data-img-prev-empty]');
                if (empty) { // заменить заглушку на картинку
                    var wrap = document.createElement('div'); wrap.className = 'asset-thumb';
                    wrap.innerHTML = '<img class="prev" data-img-prev src="' + j.path + v + '" alt="">';
                    empty.replaceWith(wrap);
                } else if (prev) { prev.src = j.path + v; prev.style.opacity = 1; }
                var dl = block.querySelector('[data-img-dl]');
                if (dl) { dl.href = j.path; dl.style.display = ''; }
                msg.textContent = 'Готово ✓ (обновите страницу, чтобы увидеть новый размер/формат)';
            })
            .catch(function () { msg.textContent = 'Сеть недоступна'; });
    });
})();
</script>
{% endblock %}
