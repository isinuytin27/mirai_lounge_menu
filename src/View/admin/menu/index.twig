{% extends 'admin/layout.twig' %}
{% block title %}Меню{% endblock %}

{% block head %}
<style>
  .mcat{margin:22px 0 6px;display:flex;align-items:center;gap:10px}
  .mcat h2{margin:0;font-size:16px}
  .mcat .g{font-size:10px;color:var(--dim);border:1px solid var(--line);padding:2px 8px;border-radius:20px}
  .mcat .line{font-size:10px;color:var(--accent2)}
  .mcat .cat-edit{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .mcat .cat-title{background:#170f1e;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:6px 9px;font-size:15px;font-weight:600;min-width:170px}
  .mcat .cat-group{background:#170f1e;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:6px 8px;font-size:12px}
  .mcat .cat-on{font-size:12px;color:var(--dim);display:flex;align-items:center;gap:4px;cursor:pointer}
  .mcat .cat-save{background:var(--accent);border:none;color:#fff;border-radius:8px;padding:6px 12px;font-size:12px;cursor:pointer}
  .mcat .cat-move{display:flex;flex-direction:column;gap:2px}
  .mcat .cat-move button{background:none;border:1px solid var(--line);color:var(--dim);border-radius:6px;padding:0 7px;font-size:11px;cursor:pointer;line-height:1.4}
  .mcat .cat-move button:hover{border-color:var(--accent2);color:var(--ink)}
  .mcat .cat-del{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:6px 10px;font-size:13px;cursor:pointer}
  .mcat .cat-del:hover{border-color:var(--accent);color:#ffb3d6}
  .addcat{margin:8px 0 18px;border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:0 14px}
  .addcat summary{cursor:pointer;font-weight:700;font-size:13px;padding:12px 0;color:var(--accent2)}
  .addcat-form{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:0 0 14px}
  .addcat-form .cat-title{min-width:200px}
  .addprod{display:flex;gap:8px;align-items:center;margin:6px 0 18px;flex-wrap:wrap}
  .addprod .ap-name{flex:1;min-width:200px;background:#170f1e;border:1px dashed var(--line);color:var(--ink);border-radius:8px;padding:8px 10px;font-size:13px}
  .addprod .ap-price{width:90px;background:#170f1e;border:1px dashed var(--line);color:var(--ink);border-radius:8px;padding:8px 10px;font-size:13px}
  .addprod .ap-btn{background:var(--accent2);border:none;color:#fff;border-radius:8px;padding:8px 14px;font-size:12px;cursor:pointer}
  .tgl.del:hover{border-color:var(--accent);color:#ffb3d6}
  .prow{display:flex;align-items:center;gap:12px;padding:10px 14px;border:1px solid var(--line);
    border-radius:12px;background:var(--panel);margin-bottom:7px}
  .prow .nm{font-weight:600;font-size:14px}
  .prow .pr{color:var(--accent);font-weight:700;font-size:13px;margin-left:6px}
  .prow .meta{margin-left:auto;display:flex;align-items:center;gap:8px}
  .pill{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px}
  .pill.on{background:rgba(57,217,138,.14);color:var(--ok)} .pill.off{background:rgba(138,131,160,.16);color:var(--dim)}
  .pill.pair{background:rgba(123,92,255,.14);color:var(--accent2)}
  .tgl{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:4px 8px;font-size:11px;cursor:pointer}
  .tgl:hover{border-color:var(--accent);color:var(--ink)}
  .edit{color:var(--accent2);font-size:13px;font-weight:600;text-decoration:none}
  .flash{background:rgba(57,217,138,.12);border:1px solid var(--line);color:var(--ok);
    padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px}
  form.inline{display:inline}
</style>
{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
    <a href="/admin" style="color:var(--dim)">← Обзор</a>
    <h1 style="margin:0;font-size:22px">Меню</h1>
    <span class="pill on" style="margin-left:auto">Postgres · запись в БД</span>
</div>
{% if flash %}<div class="flash">✓ {{ flash }}</div>{% endif %}

<details class="addcat">
    <summary>+ Новая категория</summary>
    <form class="addcat-form" method="post" action="/admin/menu/category">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <input class="cat-title" name="title" placeholder="Название категории" required>
        <select class="cat-group" name="group_id" aria-label="Группа">{% for g in groups %}<option value="{{ g.id }}">{{ g.title }}</option>{% endfor %}</select>
        <button class="cat-save" type="submit">Добавить</button>
    </form>
</details>

{% for c in categories %}
    <div class="mcat {{ c.active ? '' : 'off' }}">
        <div class="cat-move">
            <form class="inline" method="post" action="/admin/menu/category/{{ c.id }}/move/up"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button title="Выше">▲</button></form>
            <form class="inline" method="post" action="/admin/menu/category/{{ c.id }}/move/down"><input type="hidden" name="_csrf" value="{{ csrf_token() }}"><button title="Ниже">▼</button></form>
        </div>
        <form class="cat-edit" method="post" action="/admin/menu/category/{{ c.id }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <input class="cat-title" name="title" value="{{ c.title }}" aria-label="Название категории">
            <select class="cat-group" name="group_id" aria-label="Группа">
                {% for g in groups %}<option value="{{ g.id }}" {{ g.id == c.group_id ? 'selected' }}>{{ g.title }}</option>{% endfor %}
            </select>
            <label class="cat-on"><input type="checkbox" name="active" {{ c.active ? 'checked' }}> вкл</label>
            <button class="cat-save" type="submit">Сохранить</button>
        </form>
        <form class="inline" method="post" action="/admin/menu/category/{{ c.id }}/delete" onsubmit="return confirm('Удалить категорию «{{ c.title }}» вместе с {{ c.products|length }} товарами? Это необратимо.')">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <button class="cat-del" title="Удалить категорию">🗑</button>
        </form>
        <span style="margin-left:auto;color:var(--dim);font-size:12px">{{ c.products|length }} товаров · выдача {{ c.line }}</span>
    </div>
    {% for p in c.products %}
        <div class="prow">
            <div>
                <span class="nm">{{ p.name }}</span><span class="pr">{{ p.price }} ₽</span>
            </div>
            <div class="meta">
                <form class="inline" method="post" action="/admin/menu/toggle/{{ p.slug }}/visible">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <input type="hidden" name="value" value="{{ p.visible ? '' : '1' }}">
                    <button class="tgl" title="Виден гостю">{{ p.visible ? '👁 виден' : '🚫 скрыт' }}</button>
                </form>
                <form class="inline" method="post" action="/admin/menu/toggle/{{ p.slug }}/available">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <input type="hidden" name="value" value="{{ p.available ? '' : '1' }}">
                    <button class="tgl" title="В наличии (стоп-лист)">{{ p.available ? '✅ в наличии' : '⛔ стоп' }}</button>
                </form>
                <a class="edit" href="/admin/menu/product/{{ p.slug }}">Редактировать →</a>
                <form class="inline" method="post" action="/admin/menu/product/{{ p.slug }}/delete" onsubmit="return confirm('Удалить товар «{{ p.name }}»?')">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <button class="tgl del" title="Удалить товар">🗑</button>
                </form>
            </div>
        </div>
    {% endfor %}
    <form class="addprod" method="post" action="/admin/menu/product">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <input type="hidden" name="category_id" value="{{ c.id }}">
        <input class="ap-name" name="name" placeholder="+ Новый товар в «{{ c.title }}» — название" required>
        <input class="ap-price" name="price" type="number" min="0" placeholder="₽" required>
        <button class="ap-btn" type="submit">Добавить</button>
    </form>
{% endfor %}
{% endblock %}
