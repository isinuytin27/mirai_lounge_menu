{# Ярлычок ассета: фактическое расширение файла + размер, и он же — кнопка «скачать».
   Красный, если не webp или >2 МБ. Использование:
   {% import 'admin/_macros.twig' as a %} → обернуть <img> в .asset-thumb и {{ a.img_badge(path) }} #}
{% macro img_badge(path) %}
{%- set m = asset_meta(path) -%}
{%- if path -%}
<a class="asset-badge{{ m.bad ? ' bad' }}" href="/{{ path|trim('/') }}" download title="Скачать ассет · {{ m.ext|upper }} · {{ m.size }}">{{ m.ext|upper }} · {{ m.size }} ↓</a>
{%- endif -%}
{%- endmacro %}
