{% extends 'admin/layout.twig' %}
{% block title %}VIP{% endblock %}

{% block head %}
<style>
  .ev{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-bottom:8px;text-decoration:none;color:var(--ink)}
  .ev:hover{border-color:var(--accent2)}
  .ev .org{font-weight:700;font-size:15px} .ev .sl{color:var(--dim);font-size:12px}
  .ev .m{margin-left:auto;display:flex;gap:8px;align-items:center}
  .pill{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px}
  .on{background:rgba(57,217,138,.14);color:var(--ok)} .off{background:rgba(138,131,160,.16);color:var(--dim)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:600px){.grid2{grid-template-columns:1fr}}
  .check{display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer}.check input{width:18px;height:18px;accent-color:var(--accent)}
</style>
{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
    <a href="/admin" style="color:var(--dim)">← Обзор</a>
    <h1 style="margin:0;font-size:22px">VIP · Корпоративы</h1>
    <span class="pill on" style="margin-left:auto">Postgres</span>
</div>

<details class="card" style="margin-bottom:18px">
    <summary style="cursor:pointer;font-weight:700">+ Новое событие</summary>
    <form method="post" action="/admin/vip" style="margin-top:14px">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <div class="grid2">
            <div class="field"><label>Slug (для ссылки)</label><input class="input" name="slug" placeholder="gazprom26" required></div>
            <div class="field"><label>Организация</label><input class="input" name="organization"></div>
            <div class="field"><label>Дата (ГГГГ-ММ-ДД)</label><input class="input" name="event_date" placeholder="2026-04-04"></div>
            <div class="field"><label>Бесплатных напитков бара</label><input class="input" type="number" name="bar_free_limit" value="2"></div>
        </div>
        <label class="check" style="margin:6px 0 14px"><input type="checkbox" name="active" checked> Активно</label>
        <div><button class="btn" type="submit">Создать</button></div>
    </form>
</details>

{% for e in events %}
    <a class="ev" href="/admin/vip/{{ e.id }}">
        <div>
            <div class="org">{{ e.organization ?: e.slug }}</div>
            <div class="sl">/vipservice/{{ e.slug }} · {{ e.event_date }} · лимит {{ e.bar_free_limit }}</div>
        </div>
        <div class="m">
            <span class="pill {{ e.active ? 'on' : 'off' }}">{{ e.active ? 'активно' : 'выкл' }}</span>
            <span style="color:var(--dim);font-size:12px">{{ e.guests_count }} гостей</span>
        </div>
    </a>
{% else %}
    <p style="color:var(--dim)">Событий нет.</p>
{% endfor %}
{% endblock %}
