{% extends 'admin/layout.twig' %}
{% block title %}Пользователи{% endblock %}

{% block head %}
<style>
  .u{display:flex;align-items:center;gap:12px;padding:11px 14px;border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-bottom:7px}
  .u .nm{font-weight:600;font-size:14px} .u .lg{color:var(--dim);font-size:12px}
  .u .act{margin-left:auto;display:flex;gap:6px;align-items:center}
  .mini{background:#170f1e;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:5px 8px;font-size:12px}
  .del{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:5px 9px;cursor:pointer;font-size:12px}
  .del:hover{border-color:var(--accent);color:#ffb3d6}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:600px){.grid2{grid-template-columns:1fr}}
  .flash{background:rgba(57,217,138,.12);border:1px solid var(--line);color:var(--ok);padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:12px}
  .err{background:rgba(245,0,125,.12);border:1px solid var(--line);color:#ffb3d6;padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:12px}
  form.inline{display:inline}
  details.pw{margin-left:6px}
</style>
{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
    <a href="/admin" style="color:var(--dim)">← Обзор</a>
    <h1 style="margin:0;font-size:22px">Пользователи</h1>
    <span style="margin-left:auto;font-size:10px;font-weight:700;color:var(--ok);background:rgba(57,217,138,.14);padding:2px 8px;border-radius:20px">Postgres</span>
</div>
{% if flash %}<div class="flash">✓ {{ flash }}</div>{% endif %}
{% if error %}<div class="err">⚠ {{ error }}</div>{% endif %}

{% for u in users %}
    <div class="u">
        <div>
            <div class="nm">{{ u.displayName }}</div>
            <div class="lg">@{{ u.login }}</div>
        </div>
        <div class="act">
            <form class="inline" method="post" action="/admin/users/{{ u.id }}/role">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <select class="mini" name="role" onchange="this.form.submit()">
                    {% for k,l in roles %}<option value="{{ k }}" {{ k==u.role.value?'selected' }}>{{ l }}</option>{% endfor %}
                </select>
            </form>
            <details class="pw">
                <summary class="mini" style="cursor:pointer;list-style:none">🔑</summary>
                <form method="post" action="/admin/users/{{ u.id }}/password" style="margin-top:6px;display:flex;gap:6px">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <input class="mini" name="password" type="text" placeholder="новый пароль" style="width:130px">
                    <button class="mini" type="submit">OK</button>
                </form>
            </details>
            <form class="inline" method="post" action="/admin/users/{{ u.id }}/delete" onsubmit="return confirm('Удалить пользователя?')">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="del">✕</button>
            </form>
        </div>
    </div>
{% endfor %}

<details class="card" style="margin-top:16px">
    <summary style="cursor:pointer;font-weight:700">+ Новый пользователь</summary>
    <form method="post" action="/admin/users" style="margin-top:14px">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
        <div class="grid2">
            <div class="field"><label>Логин</label><input class="input" name="login" required></div>
            <div class="field"><label>Пароль</label><input class="input" name="password" type="text" required></div>
            <div class="field"><label>Имя</label><input class="input" name="first_name"></div>
            <div class="field"><label>Фамилия</label><input class="input" name="last_name"></div>
            <div class="field"><label>Роль</label>
                <select class="input" name="role">{% for k,l in roles %}<option value="{{ k }}" {{ k=='staff'?'selected' }}>{{ l }}</option>{% endfor %}</select></div>
        </div>
        <button class="btn" type="submit">Создать</button>
    </form>
</details>
{% endblock %}
