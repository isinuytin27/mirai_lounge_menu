{% extends 'admin/layout.twig' %}
{% import 'admin/_macros.twig' as a %}
{% block title %}Галерея{% endblock %}

{% block head %}
<style>
  .gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-top:16px}
  .gi{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel)}
  .gi img{width:100%;height:130px;object-fit:cover;display:block}
  .gi .cap{padding:9px 10px}
  .gi input{width:100%;background:#170f1e;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:6px 8px;font-size:12px}
  .gi .row{display:flex;gap:6px;margin-top:6px}
  .gi button{flex:1;background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:5px;font-size:11px;cursor:pointer}
  .gi button.save:hover{border-color:var(--ok);color:var(--ok)} .gi button.del:hover{border-color:var(--accent);color:#ffb3d6}
  .flash{background:rgba(57,217,138,.12);border:1px solid var(--line);color:var(--ok);padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:12px}
  .err{background:rgba(245,0,125,.12);border:1px solid var(--line);color:#ffb3d6;padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:12px}
  form.inline{display:contents}
</style>
{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
    <a href="/admin" style="color:var(--dim)">← Обзор</a>
    <h1 style="margin:0;font-size:22px">Галерея</h1>
    <span style="margin-left:auto;font-size:10px;font-weight:700;color:var(--ok);background:rgba(57,217,138,.14);padding:2px 8px;border-radius:20px">Postgres</span>
</div>
{% if flash %}<div class="flash">✓ {{ flash }}</div>{% endif %}
{% if error %}<div class="err">⚠ {{ error }}</div>{% endif %}

<form class="card" method="post" action="/admin/gallery/upload" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
        <div class="field" style="margin:0"><label>Фото (jpg/png/webp/gif)</label><input class="input" type="file" name="image" accept="image/*" required></div>
        <div class="field" style="margin:0;flex:1;min-width:180px"><label>Подпись</label><input class="input" name="caption" placeholder="Необязательно"></div>
        <button class="btn" type="submit">Загрузить</button>
    </div>
</form>

<div class="gal">
    {% for it in items %}
        <div class="gi">
            <div class="asset-thumb"><img src="/{{ it.image }}" alt="{{ it.caption }}" loading="lazy">{{ a.img_badge(it.image) }}</div>
            <div class="cap">
                <form method="post" action="/admin/gallery/{{ it.id }}/caption">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <input name="caption" value="{{ it.caption }}" placeholder="Подпись">
                    <div class="row">
                        <button class="save" type="submit">Сохранить</button>
                    </div>
                </form>
                <form method="post" action="/admin/gallery/{{ it.id }}/delete" onsubmit="return confirm('Удалить фото?')">
                    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                    <div class="row" style="margin-top:6px">
                        <button class="del" type="submit">Удалить</button>
                    </div>
                </form>
            </div>
        </div>
    {% else %}
        <p style="color:var(--dim)">Галерея пуста — загрузите первое фото.</p>
    {% endfor %}
</div>
{% endblock %}
